# Empty means same-origin /health requests; Vite forwards them to the backend.
# For a separate deployment set the public API origin, e.g. https://api.example.com.
# VITE_* values are public browser configuration: never put secrets here.
VITE_API_BASE_URL=
# Dev proxy only (not embedded into the browser bundle).
BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# Set true if OneDrive/network filesystem locking breaks the native file watcher.
CP_VITE_POLLING=false
