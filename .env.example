# Copy to .env in the repository root. Examples contain no usable credentials.
CP_APP_ENV=development
CP_DEBUG=false
CP_HOST=127.0.0.1
CP_PORT=8000
CP_LOG_LEVEL=INFO
CP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CP_MONGODB_URI=mongodb://localhost:27017
CP_MONGODB_DATABASE=careerpilot_dev
CP_NEO4J_URI=bolt://localhost:7687
CP_NEO4J_USER=neo4j
CP_NEO4J_PASSWORD=
CP_NEO4J_DATABASE=neo4j
CP_DEPENDENCY_TIMEOUT_SECONDS=3
CP_JWT_SECRET=
CP_JWT_TTL_MINUTES=60
CP_RESUME_MAX_BYTES=5242880
CP_RESUME_MAX_PAGES=20
CP_RESUME_MAX_TEXT_CHARS=200000
CP_RESUME_STORAGE_ROOT=uploads/resumes
# Compose requires a nonempty local password. Match CP_NEO4J_PASSWORD.
NEO4J_LOCAL_PASSWORD=
# Optional published ports for isolated integration infrastructure.
MONGODB_PORT=27017
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

